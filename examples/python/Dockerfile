COPY --chown=65532:65532 "examples/python" /app

ENV PYTHONPATH=/runtime:/app \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONNOUSERSITE=1 \
    PYTHONSAFEPATH=1

USER 65532:65532
