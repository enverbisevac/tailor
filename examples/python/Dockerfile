# Build: install only hash-locked dependencies.
FROM python@sha256:e48f59cdba69a3cbd9ed2cf0f348d90d45a8d350d98134cf1070bc106ee9ed90 AS build

WORKDIR /src
COPY "examples/python" /src
RUN python -m pip install \
    --no-compile \
    --no-cache-dir \
    --require-hashes \
    --only-binary=:all: \
    --target=/runtime \
    -r requirements.lock

# Runtime: application, dependencies, and the pinned Python runtime only.
FROM gcr.io/distroless/python3-debian13@sha256:6c4cb3bfa4b555429dd19541796a6ba6b30c84675b460bd0bd5072f7d5bdae71 AS runtime

